#version 450
// saxpy: c[i] = alpha * a[i] + b[i] — GPU counterpart of the CPU demo kernel.
// saxpy：c[i] = alpha*a[i] + b[i]——CPU 演示核心的 GPU 對應版。
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer A { float a[]; };
layout(set = 0, binding = 1) readonly  buffer B { float b[]; };
layout(set = 0, binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform PC { float alpha; uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) c[i] = pc.alpha * a[i] + b[i];
}
